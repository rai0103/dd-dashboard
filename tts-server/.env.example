# tts-server/.env としてコピーして使ってください（このファイル自体は空のテンプレートで、.gitignoreにより
# 実際の tts-server/.env はコミットされません）。
# 長尺動画作成のチャット機能（既存場面の書き直し・カスタム場面の生成）に、ご自身のAnthropic APIキーが必要です。
ANTHROPIC_API_KEY=

# 省略可。既定値は claude-sonnet-5-5 です。
# ANTHROPIC_MODEL=claude-sonnet-5-5

# ニュース・キーワード解説動画の「AIで画像を自動生成」機能に、ご自身のGoogle Gemini APIキーが必要です
# （Google AI Studio で発行できます）。未設定でも他の機能（台本生成・音声合成等）は通常通り使えます。
GEMINI_API_KEY=

# 省略可。既定値は gemini-nano-banana-2.1 です（画像生成対応のGeminiモデル名ならこの行で変更できます）。
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
